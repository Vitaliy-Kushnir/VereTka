rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    match /groups/{groupId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
